{
  // Cloudflare Workers Static Assets — assets-first, with a thin Worker.
  //
  // ./dist (the Astro build: the hub, both games and the site pages, plus a
  // verbatim copy of ./public) is served straight from Cloudflare's edge, so the `_headers`
  // cache rules stay in effect and asset delivery is free + fast. Run
  // `npm run build` before deploying. The Worker at ./worker/index.js runs ONLY for the app-open navigation (see
  // `run_worker_first`) so Workers Observability has a real invocation to log
  // + trace per page load — without routing every asset request through a
  // Worker (which would also bypass the `_headers` rules).
  "name": "species-bingo",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Worker-first only for the front door, where old Osa links
    // ("/?s=...") are redirected to /osa/ and each open is logged; every other
    // path (/osa/, /moplants/, img/*, fonts/*, *.css, *.js, the manifests, the
    // workers) is served directly as a static asset with its `_headers` rules
    // applied.
    "run_worker_first": ["/", "/index.html"]
  },
  // Observability captures logs + traces from Worker invocations. Each app
  // open now yields one invocation (see the Worker above); static-asset
  // requests are not invocations and won't appear here.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
