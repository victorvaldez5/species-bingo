---
// Shared page skeleton for every game. A game's own files (manifest, icons,
// species.json, images, sw.js) are relative URLs because the games sit at
// different paths (/ and /moplants/). The shared core (/core/*) and the
// tokens are root-absolute. Every script is is:inline so Astro never bundles,
// hashes or hoists it.
interface Props {
  title: string;
  description: string;
  appTitle: string;
  colorScheme?: string | null;   // <meta name="color-scheme">; none when null
  scheme?: string | null;        // <html data-scheme>; "light" opts out of dark mode
  config: string;                // the game's game.json, serialised
}
const { title, description, appTitle, colorScheme, scheme, config } = Astro.props;
// Safe inside a <script>: no "</script" or "<!--" can appear in the JSON.
const configJson = config.replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en" data-scheme={scheme ?? undefined}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <slot name="head-start" />
  <title>{title}</title>
  <meta name="description" content={description}>

  <meta name="theme-color" content="#36492e">
  {colorScheme && <meta name="color-scheme" content={colorScheme}>}
  <link rel="manifest" href="manifest.webmanifest">
  <link rel="icon" href="img/icons/icon-192.png" sizes="192x192" type="image/png">
  <link rel="apple-touch-icon" href="img/icons/icon-192.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content={appTitle}>
  <meta name="mobile-web-app-capable" content="yes">

  <link rel="stylesheet" href="/core/styles.css">
</head>
<body>
  <a class="skip-link" href="#play">Skip to the game</a>

  <header class="masthead paper-grain">
    <div class="masthead__inner">
      <span class="wnd-logo wnd-logo--cream" style="--logo-size: 20px" aria-hidden="true">
        <span class="wnd-logo__row">Wild <em>&amp;</em> Native</span>
        <span class="wnd-logo__sub"><span>Gardens</span></span>
      </span>

      <h1 class="masthead__title"><slot name="title" /></h1>
    </div>
  </header>

  <slot />

  <noscript>
    <p style="padding:24px;max-width:36rem;margin:0 auto;font-family:system-ui">
      <slot name="noscript" />
    </p>
  </noscript>

  <script is:inline type="application/json" id="game-config" set:html={configJson}></script>
  <script is:inline src="/core/deal.js"></script>
  <script is:inline src="/core/bingo.js"></script>
</body>
</html>
