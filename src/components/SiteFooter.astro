---
// The footer every page shares: the text pages, then the maker's mark (D3).
// On a game page, the credits link points at that game's own section and
// "All games" goes back to the hub.
interface Props { game?: string }
const { game } = Astro.props;
// Game pages keep the theme switch in their Actions menu; the hub and the
// text pages keep it here.
---
<footer class="site-foot">
  <nav class="site-foot__links" aria-label="Site">
    <a href="/how-to-play/">How to play</a>
    <a href="/about/">About</a>
    {game ? <a href={`/credits/#${game}`}>Photo credits</a> : <a href="/credits/">Credits</a>}
    <a href="/privacy/">Privacy</a>
    {game && <a href="/">All games</a>}
  </nav>
  {!game && (
  <div class="theme">
    <span class="theme__lbl" id="theme-lbl">Theme</span>
    <div class="seg" role="group" aria-labelledby="theme-lbl">
      <button type="button" data-theme-set="light" aria-pressed="false">Light</button>
      <button type="button" data-theme-set="dark" aria-pressed="false">Dark</button>
      <button type="button" data-theme-set="auto" aria-pressed="true">Auto</button>
    </div>
  </div>
  )}
  <p class="site-foot__maker">
    <span>made by</span>
    <span class="wnd-logo" style="--logo-size: 18px" role="img" aria-label="Wild and Native Gardens">
      <span class="wnd-logo__row" aria-hidden="true">Wild <em>&amp;</em> Native</span>
      <span class="wnd-logo__sub" aria-hidden="true"><span>Gardens</span></span>
    </span>
  </p>
</footer>
