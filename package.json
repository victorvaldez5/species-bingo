{
  "name": "species-bingo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-capable wildlife bingo for the Osa Peninsula, Costa Rica.",
  "scripts": {
    "images": "node scripts/optimize-images.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "manifest": "node scripts/build-manifest.mjs",
    "check": "node scripts/build-manifest.mjs --dry-run",
    "dev": "wrangler dev",
    "deploy": "npm run ci && wrangler deploy",
    "moplants:images": "node scripts/moplants-images.mjs",
    "moplants:credits": "node scripts/moplants-check.mjs",
    "moplants:check": "node scripts/moplants-check.mjs --dry-run",
    "test": "node --test 'test/*.test.mjs'",
    "lint": "oxlint --deny-warnings",
    "ci": "npm run lint && npm test && npm run check && npm run moplants:check"
  },
  "devDependencies": {
    "oxlint": "^1.91.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "wrangler": "^4.157.0"
  }
}
